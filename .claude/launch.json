{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "uvicorn",
        "app.api.main:app",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend-local-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_INTERNAL_URL=http://localhost:8001",
        "pnpm",
        "--dir",
        "frontend",
        "dev",
        "--port",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "demo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "demo/demo"
      ],
      "port": 8765
    }
  ]
}
